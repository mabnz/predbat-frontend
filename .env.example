# Required: Predbat plan page URL
PRED_BAT_PLAN_URL=http://your-predbat-host:5052/plan

# Optional: comma-separated fallback list, tried in order if the primary fails
# PRED_BAT_PLAN_URLS=http://predbat:5052/plan,http://localhost:5052/plan

# Optional: how often the frontend auto-refreshes plan data (default 180s)
REFRESH_INTERVAL_SECONDS=180
