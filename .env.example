# Required: Predbat plan page URL
PRED_BAT_PLAN_URL=http://your-predbat-host:5052/plan

# Optional: comma-separated fallback list, tried in order if the primary fails
# PRED_BAT_PLAN_URLS=http://predbat:5052/plan,http://localhost:5052/plan

# Optional: how often the frontend auto-refreshes plan data (default 180s)
REFRESH_INTERVAL_SECONDS=180

# Google OAuth (required to protect the app)
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be: <OAUTH_REDIRECT_BASE_URL>/auth/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
OAUTH_REDIRECT_BASE_URL=https://your-domain.example

# Comma-separated allowlist; only these emails can sign in.
ALLOWED_EMAILS=you@example.com

# Secret key for signing session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
